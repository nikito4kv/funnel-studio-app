# deploy/.env - keep it out of git (it is already ignored).

# Password of the engine database (any long string; changing it requires dropping the pg-data volume)
POSTGRES_PASSWORD=change-me

# Token of a TEST bot used by "test run" and the engine. Never put a production token here.
# The engine stores the reference env:STUDIO_TEST_TG_TOKEN for the bot - the name must match.
STUDIO_TEST_TG_TOKEN=

# Chat id that receives the Studio's test run; empty disables the test-run button
STUDIO_TEST_TG_CHAT=

# Proxy to api.telegram.org if it is blocked from the server (socks5://... or http://...). Empty = direct.
STUDIO_TG_PROXY=

# Encryption key for the bot tokens saved by the "Bots" section (data/bots.json): a random string of
# 24+ characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it means adding the bots again.
STUDIO_SECRET_KEY=

# Miro API token (scope boards:read) for "Import from Miro". Empty = the import is disabled.
MIRO_TOKEN=

# Anthropic key: sticky-note parsing through Claude where the rules are unsure. Empty = rules only.
ANTHROPIC_API_KEY=
